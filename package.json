{
  "name": "watchwise",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, AI-powered movie & show recommendations across all your streaming platforms",
  "type": "module",
  "bin": {
    "watchwise": "cli/watchwise.js"
  },
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "start": "npm run dev",
    "status": "node --env-file-if-exists=.env cli/watchwise.js status",
    "refresh": "node --env-file-if-exists=.env cli/watchwise.js refresh",
    "jobs": "node --env-file-if-exists=.env cli/watchwise.js jobs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
